# Copy to .env and replace the password. Never commit .env.
# Generate a URL-safe password:
#   openssl rand -hex 24

# Admin database credentials: migrations, backups and restore only.
POSTGRES_USER=housetory
POSTGRES_DB=housetory
# Required. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Least-privilege database role used by the API and worker. This role cannot
# create databases, create roles, or become superuser.
HOUSETORY_APP_USER=housetory_app
# Required. Generate separately with: openssl rand -hex 24
HOUSETORY_APP_PASSWORD=

# Local access (http://localhost:8080)
APP_BASE_URL=http://localhost:8080
# The address encoded in printed QR labels. For phone scanning use your
# Tailscale or LAN URL, not localhost. Defaults to APP_BASE_URL when empty.
QR_BASE_URL=
COOKIE_SECURE=false
WEB_PORT=8080

# Tailscale Serve HTTPS access:
# APP_BASE_URL=https://your-machine.your-tailnet.ts.net
# COOKIE_SECURE=true

SESSION_TTL_DAYS=30
MAX_UPLOAD_MB=25
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=900

# Local OCR in the worker container. The worker image includes Tesseract's
# English language data and Poppler. Add another Alpine language pack and set
# OCR_LANGUAGE if needed.
OCR_LANGUAGE=eng
OCR_MAX_PDF_PAGES=5


# Encrypts API keys saved through Settings → AI providers. Generate a key once
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it outside the database and include it in your secret backup. Set the old
# key in AI_CREDENTIAL_KEY_PREVIOUS only while rotating.
AI_CREDENTIAL_KEY=
AI_CREDENTIAL_KEY_PREVIOUS=

# Network exposure and optional direct TLS. Leave WEB_BIND at 127.0.0.1 for a
# private local installation. Use compose.tls.yaml for HTTPS; then APP_BASE_URL
# must be the public https:// origin and COOKIE_SECURE must be true.
WEB_BIND=127.0.0.1
WEB_PORT=8080
WEB_TLS_PORT=443
TLS_CERT_PATH=
TLS_KEY_PATH=

# Optional local AI. Disabled by default; ordinary Housetory works without it.
# In Settings, Ollama on loopback/host.docker.internal is local; LAN, Tailscale or
# external hosts are private-network/remote and require explicit consent.
# Ollama must already be running with the model pulled; the app never downloads
# models automatically. CPU-only models are expected.
AI_PROVIDER=disabled
# AI_PROVIDER=ollama
AI_MODEL=
AI_BASE_URL=http://host.docker.internal:11434
AI_TIMEOUT_SECONDS=90
AI_MAX_CONCURRENCY=1

# Optional cloud inference. Both flags must be true before any household data
# is sent to the OpenAI-compatible endpoint below.
AI_CLOUD_ENABLED=false
AI_CLOUD_CONSENT=false
AI_CLOUD_BASE_URL=
AI_CLOUD_MODEL=
AI_CLOUD_API_KEY=
AI_MAX_CONTEXT_CHARS=12000
AI_IMPORT_MAX_CHUNKS=8

# Optional reviewed online manual discovery. The built-in adapter uses the
# official Brave Search API. Obtain a subscription token from
# https://api-dashboard.search.brave.com/ and keep it server-side. Manual upload
# and attached-manual questions work without this. No Brave request is made until
# a writer confirms the item identity and presses Search.
MANUAL_SEARCH_PROVIDER=auto
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com
BRAVE_SEARCH_COUNTRY=
BRAVE_SEARCH_LANG=
# Advanced option: a custom JSON search gateway. Leave empty for Brave/auto.
MANUAL_SEARCH_URL=
MANUAL_SEARCH_API_KEY=
MANUAL_SEARCH_PROVIDER_LABEL=Configured manual search
MANUAL_SEARCH_TIMEOUT_SECONDS=20

# Optional automatic item reference-image search (actual item photos always win).
# Find image/automatic new-item lookup uses the documented Brave Image Search API
# with BRAVE_SEARCH_API_KEY above. Automatic local downloads are default-deny:
# list only source registrable domains whose terms you have reviewed and permit
# this use, comma-separated. Built-in illustrations need no policy.
ITEM_IMAGE_SEARCH_PROVIDER=auto
ITEM_IMAGE_PERMITTED_SOURCE_DOMAINS=
# Provider metadata licenses accepted as download evidence (Brave does not
# currently expose license metadata). Empty uses the built-in conservative list.
ITEM_IMAGE_PERMITTED_LICENSES=cc0,cc-by,cc-by-sa,public-domain
# Optional extra/override brand=domain|domain entries for manufacturer provenance.
ITEM_IMAGE_MANUFACTURER_DOMAINS=
# Optional extra brand names for conservative query-only inference.
ITEM_IMAGE_KNOWN_BRANDS=

# Inventory evidence packages. PDF is always generated; CSV and the original
# attachments ZIP are optional at export time. Generated artifacts are private,
# expire automatically and never delete source documents/photos.
EVIDENCE_EXPORT_MAX_ITEMS=300
EVIDENCE_EXPORT_MAX_DOCUMENTS=300
EVIDENCE_EXPORT_MAX_PHOTOS=500
EVIDENCE_EXPORT_MAX_BUNDLE_MB=100
EVIDENCE_EXPORT_MAX_PDF_PHOTOS=60
EVIDENCE_EXPORT_RETENTION_HOURS=168
EVIDENCE_EXPORT_TIMEOUT_SECONDS=180

# Stocktake bounds. Observations are append-only evidence and sessions/checks are
# retained; abandoned sessions do not update last-checked state.
STOCKTAKE_MAX_ITEMS=500
STOCKTAKE_MAX_APPLY_BATCH=200
STOCKTAKE_MAX_ACTIVE_SESSIONS=25
STOCKTAKE_MAX_NOTES_CHARS=2000
STOCKTAKE_MAX_OBSERVATIONS_PER_SESSION=2000

# Private generated evidence artifacts use a separate writable volume by default.
EXPORTS_DIR=/data/exports

# Bulk import archive limits. The worker rejects larger vaults before reading
# their content.
IMPORT_MAX_FILES=2000
IMPORT_MAX_TOTAL_MB=50
IMPORT_MAX_FILE_MB=10

# Voice notes. Audio is validated by signature, bounded by size/duration and
# deleted after a successful transcript or cancellation. Failed audio is kept
# privately for retry until the user cancels.
VOICE_MAX_UPLOAD_MB=15
VOICE_MAX_DURATION_SECONDS=120
VOICE_MAX_ACTIVE_NOTES=10
VOICE_MAX_SUGGESTIONS=50
VOICE_MAX_TRANSCRIPT_CHARS=12000

# Provider-neutral SMTP for invitations and password recovery. Leave SMTP_HOST
# and SMTP_FROM_ADDRESS empty to keep login/inventory working while email is
# unconfigured. Any standard SMTP provider works; this Resend block is only a
# documented example. Generate/supply its restricted key separately and never
# commit it. Use STARTTLS on 587 or implicit TLS (SMTP_TLS_MODE=ssl) on 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Housetory
SMTP_FROM_ADDRESS=
SMTP_TIMEOUT_SECONDS=10
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_TLS_MODE=starttls
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=noreply@mail.example.com
