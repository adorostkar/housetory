# Copy to .env and replace the password. Never commit .env.
# Generate a URL-safe password:
#   openssl rand -hex 24

# Admin database credentials: migrations, backups and restore only.
POSTGRES_USER=housetory
POSTGRES_DB=housetory
# Required. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Least-privilege database role used by the API and worker. This role cannot
# create databases, create roles, or become superuser.
HOUSETORY_APP_USER=housetory_app
# Required. Generate separately with: openssl rand -hex 24
HOUSETORY_APP_PASSWORD=

# Local access (http://localhost:8080)
APP_BASE_URL=http://localhost:8080
# The address encoded in printed QR labels. For phone scanning use your
# Tailscale or LAN URL, not localhost. Defaults to APP_BASE_URL when empty.
QR_BASE_URL=
COOKIE_SECURE=false
WEB_PORT=8080

# Tailscale Serve HTTPS access:
# APP_BASE_URL=https://your-machine.your-tailnet.ts.net
# COOKIE_SECURE=true

SESSION_TTL_DAYS=30
MAX_UPLOAD_MB=25
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=900

# Local OCR in the worker container. The worker image includes Tesseract's
# English language data and Poppler. Add another Alpine language pack and set
# OCR_LANGUAGE if needed.
OCR_LANGUAGE=eng
OCR_MAX_PDF_PAGES=5


# Encrypts API keys saved through Settings → AI providers. Generate a key once
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it outside the database and include it in your secret backup. Set the old
# key in AI_CREDENTIAL_KEY_PREVIOUS only while rotating.
AI_CREDENTIAL_KEY=
AI_CREDENTIAL_KEY_PREVIOUS=

# Network exposure and optional direct TLS. Leave WEB_BIND at 127.0.0.1 for a
# private local installation. Use compose.tls.yaml for HTTPS; then APP_BASE_URL
# must be the public https:// origin and COOKIE_SECURE must be true.
WEB_BIND=127.0.0.1
WEB_PORT=8080
WEB_TLS_PORT=443
TLS_CERT_PATH=
TLS_KEY_PATH=

# Optional local AI. Disabled by default; ordinary Housetory works without it.
# In Settings, Ollama on loopback/host.docker.internal is local; LAN, Tailscale or
# external hosts are private-network/remote and require explicit consent.
# Ollama must already be running with the model pulled; the app never downloads
# models automatically. CPU-only models are expected.
AI_PROVIDER=disabled
# AI_PROVIDER=ollama
AI_MODEL=
AI_BASE_URL=http://host.docker.internal:11434
AI_TIMEOUT_SECONDS=90
AI_MAX_CONCURRENCY=1

# Optional cloud inference. Both flags must be true before any household data
# is sent to the OpenAI-compatible endpoint below.
AI_CLOUD_ENABLED=false
AI_CLOUD_CONSENT=false
AI_CLOUD_BASE_URL=
AI_CLOUD_MODEL=
AI_CLOUD_API_KEY=
AI_MAX_CONTEXT_CHARS=12000
AI_IMPORT_MAX_CHUNKS=8

# Bulk import archive limits. The worker rejects larger vaults before reading
# their content.
IMPORT_MAX_FILES=2000
IMPORT_MAX_TOTAL_MB=50
IMPORT_MAX_FILE_MB=10
